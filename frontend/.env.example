# ---------------------------------------------------------------------------
# AgentFinance frontend — environment reference
# Copy to .env.local for local development, or set these in Render.
# ---------------------------------------------------------------------------

# REQUIRED at build time for production. The public origin of the backend API,
# WITHOUT a trailing slash. This value is baked into the client bundle, so the
# service must be rebuilt after changing it.
# Example: https://YOUR-BACKEND-service-name.onrender.com
NEXT_PUBLIC_API_URL=

# Optional. If unset, the WebSocket endpoint derives from NEXT_PUBLIC_API_URL
# (https://... -> wss://...). The backend serves HTTP + WebSocket on one port.
NEXT_PUBLIC_WS_URL=

# Optional public, non-secret configuration.
NEXT_PUBLIC_AGENTS=alpha,beta,gamma
NEXT_PUBLIC_REPLAY_ENABLED=false

# Optional WalletConnect project id (public by design). When set, enabling
# WalletConnect-based wallet flows becomes possible; when unset the UI shows a
# plain install-link fallback instead of dead deep links.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# NEVER expose the following in NEXT_PUBLIC_* variables:
#   DATABASE_URL, REDIS_URL, JWT_SECRET, TREASURY_PRIVATE_KEY, provider API keys
# ---------------------------------------------------------------------------