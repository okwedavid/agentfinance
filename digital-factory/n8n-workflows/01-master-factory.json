{
  "name": "01 - DIGITAL FACTORY MASTER",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "minutesInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "Schedule Daily Batch",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "path": "digital-factory",
        "options": {}
      },
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        460,
        500
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "batch-size",
              "name": "batch_size",
              "value": 3,
              "type": "number"
            },
            {
              "id": "min-score",
              "name": "min_quality_score",
              "value": 7,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "set-config",
      "name": "Set Factory Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        400
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "02 - IDEA GENERATOR"
        },
        "data": "={{ { batch_size: $json.batch_size } }}"
      },
      "id": "call-idea-generator",
      "name": "Idea Generator Sub-Workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        900,
        400
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "03 - EVALUATOR"
        },
        "data": "={{ $json }}"
      },
      "id": "call-evaluator",
      "name": "Evaluator Gate",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1120,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.verdict }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "APPROVED"
            },
            {
              "leftValue": "={{ $json.overall }}",
              "operator": {
                "type": "number",
                "operation": "largerEqual"
              },
              "rightValue": "={{ $('Set Factory Config').item.json.min_quality_score }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-approved",
      "name": "IF Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        400
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "04 - CONTENT FACTORY (Parallel)"
        },
        "data": "={{ $json }}"
      },
      "id": "call-content-factory",
      "name": "Content Factory (Parallel)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "05 - HTML-PDF GENERATOR"
        },
        "data": "={{ $json }}"
      },
      "id": "call-html-pdf",
      "name": "HTML & PDF Generator",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1760,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "06 - PUBLISHING ASSETS"
        },
        "data": "={{ $json }}"
      },
      "id": "call-publishing",
      "name": "Publishing Assets Generator",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1980,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "07 - PACKAGER & COVER"
        },
        "data": "={{ $json }}"
      },
      "id": "call-packager",
      "name": "Packager + Cover + ZIP",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "08 - ECOMMERCE PUBLISHERS"
        },
        "data": "={{ $json }}"
      },
      "id": "call-publishers",
      "name": "Publish to Gumroad/Etsy/Shopify",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        2420,
        300
      ]
    },
    {
      "parameters": {
        "content": "## \u2705 Product Factory Completed\n\n**Product:** {{ $json.brand_name }} | {{ $json.slug }}\n**Price:** ${{ $json.price }}\n**Score:** {{ $json.overall }}/10\n**Files:** Customer/, Publishing/, Internal/\n\nNext: Check C:\\DigitalFactory\\Products\\{{ $json.slug }}\n\nNow publishing to ecommerce automatically...",
        "height": 400,
        "width": 600
      },
      "id": "sticky-success",
      "name": "Success Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        2400,
        600
      ]
    }
  ],
  "connections": {
    "Schedule Daily Batch": {
      "main": [
        [
          {
            "node": "Set Factory Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Set Factory Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Factory Config": {
      "main": [
        [
          {
            "node": "Idea Generator Sub-Workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Idea Generator Sub-Workflow": {
      "main": [
        [
          {
            "node": "Evaluator Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluator Gate": {
      "main": [
        [
          {
            "node": "IF Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Approved?": {
      "main": [
        [
          {
            "node": "Content Factory (Parallel)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Content Factory (Parallel)": {
      "main": [
        [
          {
            "node": "HTML & PDF Generator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTML & PDF Generator": {
      "main": [
        [
          {
            "node": "Publishing Assets Generator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publishing Assets Generator": {
      "main": [
        [
          {
            "node": "Packager + Cover + ZIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Packager + Cover + ZIP": {
      "main": [
        [
          {
            "node": "Publish to Gumroad/Etsy/Shopify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "instanceId": "digital-factory-master"
  }
}