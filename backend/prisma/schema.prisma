model TaskAnalytics {
  id           String   @id @default(cuid())
  taskId       String
  action       String
  status       String
  durationMs   Int?
  result       Json?
  createdAt    DateTime @default(now())
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  prompt    String   @default("")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?  @unique
  emailVerified Boolean  @default(false)
  emailVerificationToken String? @unique
  emailVerificationExpiresAt DateTime?
  // Legacy single-column OAuth link, retained so existing rows keep resolving.
  // Multi-provider linking uses AuthIdentity below; a user may hold several
  // provider identities at once, which this column can no longer represent.
  oauthId       String?  @unique
  passwordHash  String
  role          String   @default("USER") // USER | ADMIN | SUPER_ADMIN, server-authoritative
  displayName   String?
  bio           String?
  walletAddress String?
  walletProfiles Json?
  preferredNetwork String? @default("ethereum")
  createdAt     DateTime  @default(now())
  sessions      AuthSession[]
  identities    AuthIdentity[]
  tasks         Task[]
  payouts       Payout[]
  digitalProducts DigitalProduct[]
}

// One external provider account linked to exactly one AgentFinance user.
//
// The previous single `User.oauthId` column could hold only ONE provider per
// user, so linking a second provider overwrote the first and silently
// orphaned the original login. This table holds many identities per user while
// still guaranteeing that a given provider account maps to exactly one user.
model AuthIdentity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   // google | facebook | x
  providerUserId  String   // stable per-provider subject id
  email           String?
  // Whether the provider asserted this email was verified. Email-based account
  // linking is only allowed when this is true; an unverified provider email is
  // attacker-controllable and must never be used to claim an existing account.
  emailVerified   Boolean  @default(false)
  createdAt       DateTime @default(now())
  lastLoginAt     DateTime?

  // A provider account can belong to only one AgentFinance user. This is what
  // makes duplicate linking detectable instead of silently merging accounts.
  @@unique([provider, providerUserId])
  @@index([userId])
}

// Durable store for the OAuth `state` handshake.
//
// This was an in-process Map, which breaks on Render: the /start and /callback
// hops can be served by different instances (scale-out, spin-down, redeploy), so
// the state issued by one instance is simply absent on the other and a
// perfectly valid login fails with "invalid or expired state".
model OAuthState {
  state     String   @id
  provider  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Task {
  id          String    @id @default(cuid())
  agentId     String?
  userId      String?
  action      String
  input       String?
  status      String    @default("pending")
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?
  result      String?
  archived    Boolean   @default(false)
  retryCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  Agent    Agent?    @relation(fields: [agentId], references: [id])
  User     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  taskId    String?
  sender    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task?    @relation(fields: [taskId], references: [id])
}

model CoordinatorTask {
  id         String    @id @default(cuid())
  rootTaskId String?
  agentId    String?
  status     String    @default("pending")
  plan       Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  subtasks   SubTask[]
}

model SubTask {
  id            String           @id @default(cuid())
  coordinatorId String?
  taskId        String?
  type          String
  payload       Json?
  status        String           @default("pending")
  attempts      Int              @default(0)
  maxAttempts   Int              @default(3)
  lastError     String?
  result        Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  CoordinatorTask CoordinatorTask? @relation(fields: [coordinatorId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  kind      String
  payload   Json
  createdAt DateTime @default(now())
}

model TokenUsage {
  id               String   @id @default(cuid())
  taskId           String?
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costCents        Int
  createdAt        DateTime @default(now())
}

model Payout {
  id               String   @id @default(cuid())
  userId           String
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId           String?
  network          String
  assetSymbol      String
  amount           String
  recipientAddress String
  treasuryAddress  String?
  status           String   @default("draft")
  summary          String?
  approvalToken    String?
  unsignedPayload  Json?
  signedPayload    Json?
  txHash           String?
  error            String?
  createdAt        DateTime @default(now())
  approvedAt       DateTime?
  broadcastAt      DateTime?
  confirmedAt      DateTime?
  rejectedAt       DateTime?
  updatedAt        DateTime @updatedAt
}

model RewardEvent {
  id                 String   @id @default(cuid())
  taskId             String?  @unique
  computeJobId       String?  @unique
  userId             String
  agent              String
  rewardType         String   @default("TASK_COMPLETION")
  rewardAmountBnb    String
  rewardAsset        String   @default("BNB")
  calculationVersion String
  taskValueMetric    Json?
  status             String   @default("CREDITED")
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model RewardLedger {
  id                String   @id @default(cuid())
  userId            String
  entryType         String
  direction         String
  amountBnb         String
  runningBalanceBnb String
  referenceId       String?
  note              String?
  meta              Json?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model UserRewardBalance {
  userId         String   @id
  totalEarnedBnb String   @default("0")
  settledBnb     String   @default("0")
  reservedBnb    String   @default("0")
  updatedAt      DateTime @updatedAt
}

model RewardPool {
  id           Int      @id @default(autoincrement())
  generatedBnb String   @default("0")
  fundedBnb    String   @default("0")
  settledBnb   String   @default("0")
  reservedBnb  String   @default("0")
  updatedAt    DateTime @updatedAt
}

model PoolFundingEvent {
  id          String    @id @default(cuid())
  sourceType  String
  // Economic truth (phase 0): where the funding actually came from.
  //   EXTERNAL_REVENUE - only written by a verified external payment
  //   OPERATOR_FUNDING - operator's own money (subsidy/capital), NOT earned
  //   TEST_FUNDING     - seeded for development only
  //   UNCLASSIFIED     - legacy rows predating the taxonomy, left un-attributed
  // Existing rows backfill to UNCLASSIFIED so no historical amount is
  // retroactively re-labelled as real external revenue.
  fundingClass String    @default("UNCLASSIFIED")
  amountBnb   String
  reference   String?
  status      String    @default("PENDING")
  simulated   Boolean   @default(false)
  confirmedBy String?
  confirmedAt DateTime?
  note        String?
  meta        Json?
  createdAt   DateTime  @default(now())

  @@index([fundingClass])
}

model SettlementRecord {
  id         String   @id @default(cuid())
  payoutId   String   @unique
  userId     String
  amountBnb  String
  status     String   @default("RESERVED")
  reservedAt DateTime @default(now())
  releasedAt DateTime?
  settledAt  DateTime?
  settledBy  String?
  txHash     String?
  note       String?

  @@index([userId])
}

model DigitalProduct {
  id                String   @id @default(cuid())
  slug              String   @unique
  brandName         String
  title             String
  outcome           String?
  tagline           String?
  avatar            String?
  pain              String?
  dreamOutcome      String?
  price             Int      @default(49)
  priceTiers        Json?
  keywords          Json?
  bundleWith        Json?
  modules           Json?
  deliverables      Json?
  differentiation   String?
  status            String   @default("draft") // draft, evaluating, approved, rejected, generating, published
  evaluation        Json?
  files             Json?    // manifest of customer files
  publishingAssets  Json?    // all listing + socials
  internal          Json?    // generation logs
  manifest          Json?
  ecommerce         Json?    // publish results {gumroad, shopify, etsy...}
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FactoryRun {
  id            String   @id @default(cuid())
  userId        String?
  batchSize     Int      @default(1)
  approvedCount Int      @default(0)
  rejectedCount Int      @default(0)
  products      Json?
  status        String   @default("running")
  createdAt     DateTime @default(now())
  completedAt   DateTime?
}

// ── Phase 4: Compute-to-Revenue economy ──────────────────────────────────────
// Server-managed, additive models. User references are indexed strings (no FK
// onto User) so account deletion and legacy rows remain untouched.

model ServiceCatalog {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  agent            String   @default("general") // research | general | content
  unitPriceBnb     String   // server-authoritative base price in BNB
  category         String   @default("compute")
  enabled          Boolean  @default(true)
  meta             Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ComputeQuote {
  id              String         @id @default(cuid())
  serviceId       String
  userId          String
  requestText     String?        // customer compute request (bounded)
  asset           String         @default("BNB") // BNB | USDT | USDC
  amountWei       String         // customer price in asset units (1e18)
  priceBnbWei     String         // normalized BNB price (1e18)
  priceBnbPerUnit String?        // operator reference BNB-per-unit when asset != BNB
  platformFeeBnbWei String       // platform gross-margin portion
  serviceCostBnbWei String       // recorded expected cost portion
  nonce           String         @unique
  payloadHash     String
  status          String         @default("PENDING") // PENDING | PAID | EXPIRED | REFUNDED
  expiresAt       DateTime
  createdAt       DateTime       @default(now())

  @@index([userId])
  @@index([serviceId])
}

model PaymentIntent {
  id               String    @id @default(cuid())
  quoteId          String    @unique
  asset            String
  amountWei        String
  priceBnbPerUnit  String?
  status           String    @default("PENDING") // PENDING | VERIFIED | SETTLED | FAILED | REFUNDED
  verificationType String    @default("MANUAL_CERT") // SIMULATED | MANUAL_CERT
  external         Boolean   @default(true)
  txHash           String?
  payerLabel       String?
  customerId       String?
  verifiedAt       DateTime?
  verifiedBy       String?
  settledAt        DateTime?
  note             String?
  createdAt        DateTime  @default(now())

  @@index([quoteId])
}

model ComputeCustomer {
  id             String   @id @default(cuid())
  displayName    String
  external       Boolean  @default(false)
  creditsPaid    Int      @default(0)
  meta           Json?
  createdAt      DateTime @default(now())
}

model ComputeJob {
  id                String   @id @default(cuid())
  quoteId           String
  serviceId         String
  sellerUserId      String?  // reward recipient (contributor); null = no contributor configured, so no reward is credited
  payerUserId       String?  // party that paid; must differ from sellerUserId
  inputText         String?  // compute request executed by the fleet
  agent             String   @default("general")
  taskId            String?  // underlying agent Task row (traceability)
  status            String   @default("DRAFT") // DRAFT | RUNNING | COMPLETED | FAILED | REFUNDED
  expectedPriceBnbWei String
  economicValueBnb  String   @default("0") // monetized value; 0 until verified revenue
  revenueEventId    String?
  failureReason     String?
  failureType       String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sellerUserId])
  @@index([serviceId])
  @@index([status])
}

model ComputeOutput {
  id         String   @id @default(cuid())
  jobId      String   @unique
  resultText String
  resultHash String   // sha256 hex of canonical output
  sizeBytes  Int
  engine     String   @default("agent-fleet")
  createdAt  DateTime @default(now())
}

model ComputeCost {
  id        String   @id @default(cuid())
  jobId     String
  costAsset String   @default("BNB")
  amountWei String
  costKind  String   @default("INFERENCE") // INFERENCE | COMPUTE | ELECTRICITY | HUMAN
  source    String   @default("INTERNAL") // INTERNAL | EXTERNAL
  createdAt DateTime @default(now())

  @@index([jobId])
}

model RevenueEvent {
  id               String   @id @default(cuid())
  jobId            String
  paymentIntentId  String
  asset            String
  amountWei        String
  bnbEquivalentWei String
  source           String   @default("COMPUTE_JOB")
  monetizerType    String   @default("CUSTOMER_PAYMENT")
  external         Boolean  @default(true)
  simulated        Boolean  @default(false)
  // Economic truth (phase 0): how this revenue was evidenced.
  //   SIMULATED          - demo-mode synthetic payer
  //   OPERATOR_ASSERTED  - operator declared it; self-referential HMAC, NOT
  //                        independent proof that money was received
  //   EXTERNAL_VERIFIED  - evidence from outside the platform (none exists yet)
  // Backfilled from the originating PaymentIntent so history keeps its meaning.
  // The legacy `external` boolean is retained unchanged: it records the
  // architecture's intent and is NOT a claim of external verification.
  verificationMethod String   @default("OPERATOR_ASSERTED")
  status           String   @default("BOOKED")
  createdAt        DateTime @default(now())

  @@index([jobId])
  @@index([verificationMethod])
  @@unique([paymentIntentId])
}

model RevenueAllocation {
  id               String   @id @default(cuid())
  revenueEventId   String
  allocationType   String   // REWARD_FUNDING | PLATFORM
  asset            String
  amountWei        String
  bnbEquivalentWei String
  simulated        Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([revenueEventId])
  @@index([allocationType])
}
