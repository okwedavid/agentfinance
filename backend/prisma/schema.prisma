model TaskAnalytics {
  id           String   @id @default(cuid())
  taskId       String
  action       String
  status       String
  durationMs   Int?
  result       Json?
  createdAt    DateTime @default(now())
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  prompt    String   @default("")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?  @unique
  passwordHash  String
  role          String   @default("USER") // USER | ADMIN | SUPER_ADMIN, server-authoritative
  displayName   String?
  bio           String?
  walletAddress String?
  walletProfiles Json?
  preferredNetwork String? @default("ethereum")
  createdAt     DateTime @default(now())
  sessions      AuthSession[]
  tasks         Task[]
  payouts       Payout[]
  digitalProducts DigitalProduct[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  agentId     String?
  userId      String?
  action      String
  input       String?
  status      String    @default("pending")
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?
  result      String?
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  Agent    Agent?    @relation(fields: [agentId], references: [id])
  User     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  taskId    String?
  sender    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task?    @relation(fields: [taskId], references: [id])
}

model CoordinatorTask {
  id         String    @id @default(cuid())
  rootTaskId String?
  agentId    String?
  status     String    @default("pending")
  plan       Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  subtasks   SubTask[]
}

model SubTask {
  id            String           @id @default(cuid())
  coordinatorId String?
  taskId        String?
  type          String
  payload       Json?
  status        String           @default("pending")
  attempts      Int              @default(0)
  maxAttempts   Int              @default(3)
  lastError     String?
  result        Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  CoordinatorTask CoordinatorTask? @relation(fields: [coordinatorId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  kind      String
  payload   Json
  createdAt DateTime @default(now())
}

model TokenUsage {
  id               String   @id @default(cuid())
  taskId           String?
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costCents        Int
  createdAt        DateTime @default(now())
}

model Payout {
  id               String   @id @default(cuid())
  userId           String
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId           String?
  network          String
  assetSymbol      String
  amount           String
  recipientAddress String
  treasuryAddress  String?
  status           String   @default("draft")
  summary          String?
  approvalToken    String?
  unsignedPayload  Json?
  signedPayload    Json?
  txHash           String?
  error            String?
  createdAt        DateTime @default(now())
  approvedAt       DateTime?
  broadcastAt      DateTime?
  confirmedAt      DateTime?
  rejectedAt       DateTime?
  updatedAt        DateTime @updatedAt
}

model DigitalProduct {
  id                String   @id @default(cuid())
  slug              String   @unique
  brandName         String
  title             String
  outcome           String?
  tagline           String?
  avatar            String?
  pain              String?
  dreamOutcome      String?
  price             Int      @default(49)
  priceTiers        Json?
  keywords          Json?
  bundleWith        Json?
  modules           Json?
  deliverables      Json?
  differentiation   String?
  status            String   @default("draft") // draft, evaluating, approved, rejected, generating, published
  evaluation        Json?
  files             Json?    // manifest of customer files
  publishingAssets  Json?    // all listing + socials
  internal          Json?    // generation logs
  manifest          Json?
  ecommerce         Json?    // publish results {gumroad, shopify, etsy...}
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FactoryRun {
  id            String   @id @default(cuid())
  userId        String?
  batchSize     Int      @default(1)
  approvedCount Int      @default(0)
  rejectedCount Int      @default(0)
  products      Json?
  status        String   @default("running")
  createdAt     DateTime @default(now())
  completedAt   DateTime?
}
