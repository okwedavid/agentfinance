# ---------------------------------------------------------------------------
# AgentFinance backend — environment reference (Phase 1)
# Copy to .env for local development, or set these server-side in Render.
# ---------------------------------------------------------------------------

# ── Core (required) ────────────────────────────────────────────────────────────
DATABASE_URL=
JWT_SECRET=

# Redis + queue. When unset, tasks run inline in the same process (still with a
# global timeout, retries and fallback provider).
REDIS_URL=

# ── AI provider selection (required for real agent execution) ─────────────────
# At least ONE provider must be configured with a valid API key.
# Primary is chosen with LLM_PROVIDER; otherwise the first configured provider
# from the priority list is used: groq → google → anthropic → openrouter →
# together → mistral → cerebras.
LLM_PROVIDER=groq

# Optional fallback provider tried when the primary fails (must have its key set).
LLM_FALLBACK_PROVIDER=

# Provider API keys (set the ones you use; these are secret — never expose to
# the frontend and never log them).
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=

# Optional per-provider model overrides (replace an obsolete default if needed).
GROQ_MODEL=
GOOGLE_AI_MODEL=          # default gemini-2.5-flash (gemini-2.0-flash is retired)
ANTHROPIC_MODEL=
OPENROUTER_MODEL=
TOGETHER_MODEL=
MISTRAL_MODEL=
CEREBRAS_MODEL=
# Optional OpenRouter attribution headers.
OPENROUTER_REFERER=
OPENROUTER_SITE=

# ── Task execution tuning ─────────────────────────────────────────────────────
# Overall per-task budget. A task can never stay running beyond this; the
# in-flight provider request is aborted and the task is marked failed.
AGENT_TASK_TIMEOUT_MS=120000
# Bounded retries for *transient* provider failures (rate limit / unavailable /
# network). Auth and configuration errors are never retried.
AGENT_PROVIDER_RETRIES=2

# ── Tool/optional data integrations (optional) ────────────────────────────────
# One unavailable integration degrades gracefully and never blocks agent tasks.
TAVILY_API_KEY=
SERPER_API_KEY=
COINGECKO_API_KEY=
CMC_API_KEY=
ALCHEMY_API_KEY=

# ── OAuth login (Google / Facebook / X) ───────────────────────────────────────
# A provider is only usable when BOTH its CLIENT_ID and CLIENT_SECRET are set.
# Required so the OAuth callback can redirect back to the frontend, where the
# session token is delivered in the URL fragment.
# Example: https://agentfinance.onrender.com
OAUTH_SUCCESS_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional redirect URI override (defaults to <PUBLIC_BACKEND_URL>/auth/oauth/<provider>/callback).
# PUBLIC_BACKEND_URL=
# GOOGLE_REDIRECT_URI=
# FACEBOOK_REDIRECT_URI=
# X_REDIRECT_URI=

# ── Roles / accounts / CORS ───────────────────────────────────────────────────
SUPER_ADMIN_USERNAME=okwedavid
ADMIN_USERNAMES=
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# NEVER set any of the following in NEXT_PUBLIC_* variables (frontend):
#   DATABASE_URL, REDIS_URL, JWT_SECRET, TREASURY_PRIVATE_KEY, provider keys,
#   OAuth client secrets.
# ---------------------------------------------------------------------------